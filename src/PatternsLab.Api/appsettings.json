{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite"
  },

  "ConnectionStrings": {
    "Sqlite": "Data Source=patternslab.db",
    "SqlServer": "Server=.;Database=PatternsLab;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "Workers": {
    "ClaimChaser": {
      "Enabled": true,
      "IntervalMinutes": 30,
      "PayerCode": "PBM-01"
    }
  }
}
